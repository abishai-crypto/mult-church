APP_NAME="EAGT Golani - Kimara Suka"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=sw
APP_FALLBACK_LOCALE=sw
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# DATABASE CONFIGURATION (Badili hapa kulingana na Seva ya Cloud au Local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mult_church
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# SMS GATEWAY SETTINGS (Beem Africa, NextSMS, Twilio au log kwa majaribio)
SMS_PROVIDER=log
# Beem Africa (Tanzania)
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_NAME=EAGT
# NextSMS (Tanzania)
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
NEXTSMS_SENDER_ID=EAGT
# Twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# MAIL SETTINGS (Weka SMTP ya kanisa k.m. info@eagt.org au Brevo/Resend)
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@eagt.org"
MAIL_FROM_NAME="${APP_NAME}"

# CLOUD OBJECT STORAGE (Kwa ajili ya S3 au Cloudflare R2 ukiwa Cloud)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
